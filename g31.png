flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="relative max-w-[var(--user-chat-width,70%)] bg-token-message-surface rounded-3xl px-5 py-2.5"><div class="whitespace-pre-wrap">Tolong buatkan gambar beranimasi untuk mewakilkan cerita ini
&lt;!-- Fase 5: Operasi Pecahan (RME Kontekstual) --&gt;


                &lt;!-- 1. Penjumlahan Pecahan --&gt;
                
                            &lt;!-- Hari 1 --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:100px;height:100px;background:conic-gradient(#FF7D00 0% 37.5%, #f8fafc 37.5% 100%);border-radius:50%;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#FF7D00;"&gt;\(\frac{3}{8}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Hari Pertama&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Plus Symbol --&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#3B82F6;"&gt;+&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Hari 2 --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:100px;height:100px;background:conic-gradient(#FF7D00 0% 25%, #f8fafc 25% 100%);border-radius:50%;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#FF7D00;"&gt;\(\frac{2}{8}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Hari Kedua&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Equal Symbol --&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#3B82F6;"&gt;=&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Hasil --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:100px;height:100px;background:conic-gradient(#FF7D00 0% 62.5%, #f8fafc 62.5% 100%);border-radius:50%;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#FF7D00;"&gt;\(\frac{5}{8}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Total&lt;/p&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                        
                        &lt;div style="background:#DBEAFE;padding:1rem;border-radius:8px;margin-top:1rem;"&gt;
                            &lt;p style="color:#1E40AF;margin:0;font-weight:500;"&gt;Aturan: Jika penyebut sama, jumlahkan pembilangnya: \(\frac{3}{8} + \frac{2}{8} = \frac{3+2}{8} = \frac{5}{8}\)&lt;/p&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                    
                    &lt;!-- Penyebut Berbeda --&gt;
                    &lt;div style="background:#F0FDF4;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;"&gt;
                        &lt;h4 style="color:#166534;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                            &lt;i class="fas fa-utensils" style="color:#22C55E;"&gt;&lt;/i&gt; Kasus Resep
                        &lt;/h4&gt;
                        &lt;p style="color:#4a5568;"&gt;Ima mencampur \(\frac{1}{2}\) kg gula merah dan \(\frac{1}{3}\) kg gula pasir. Berapa total gula?&lt;/p&gt;
                        
                        &lt;div style="display:flex;justify-content:center;gap:1rem;margin-top:1rem;flex-wrap:wrap;"&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:60px;background:linear-gradient(to right, #FF9F1C 0% 50%, #f8fafc 50% 100%);border-radius:6px;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:25%;transform:translate(-50%,-50%);font-weight:bold;color:#166534;"&gt;\(\frac{1}{2}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Gula Merah&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#22C55E;"&gt;+&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:60px;background:linear-gradient(to right, #FF9F1C 0% 33.33%, #f8fafc 33.33% 100%);border-radius:6px;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:16.66%;transform:translate(-50%,-50%);font-weight:bold;color:#166534;"&gt;\(\frac{1}{3}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Gula Pasir&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#22C55E;"&gt;=&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:60px;background:linear-gradient(to right, #FF9F1C 0% 83.33%, #f8fafc 83.33% 100%);border-radius:6px;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:41.66%;transform:translate(-50%,-50%);font-weight:bold;color:#166534;"&gt;\(\frac{5}{6}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Total&lt;/p&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                        
                        &lt;div style="background:#DCFCE7;padding:1rem;border-radius:8px;margin-top:1rem;"&gt;
                            &lt;p style="color:#166534;margin:0;font-weight:500;"&gt;Langkah Penyelesaian:&lt;/p&gt;
                            &lt;ol style="color:#166534;margin:0.5rem 0 0 1rem;padding-left:1rem;"&gt;
                                &lt;li&gt;Cari KPK penyebut: KPK dari 2 dan 3 adalah 6&lt;/li&gt;
                                &lt;li&gt;Ubah ke pecahan senilai: \(\frac{1}{2} = \frac{3}{6}\) dan \(\frac{1}{3} = \frac{2}{6}\)&lt;/li&gt;
                                &lt;li&gt;Jumlahkan: \(\frac{3}{6} + \frac{2}{6} = \frac{5}{6}\)&lt;/li&gt;
                            &lt;/ol&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- 2. Pengurangan Pecahan --&gt;
                &lt;div style="margin:2rem 0;"&gt;
                    &lt;h3 style="color:#4a5568;display:flex;align-items:center;gap:12px;font-weight:600;"&gt;
                        &lt;i class="fas fa-minus-circle" style="color:#EF4444;font-size:1.2em;"&gt;&lt;/i&gt; Pengurangan Pecahan
                    &lt;/h3&gt;
                    
                    &lt;!-- Contoh Kontekstual --&gt;
                    &lt;div style="background:#FEF2F2;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;"&gt;
                        &lt;h4 style="color:#991B1B;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                            &lt;i class="fas fa-box-open" style="color:#EF4444;"&gt;&lt;/i&gt; Kasus Stok Bakpia
                        &lt;/h4&gt;
                        &lt;p style="color:#4a5568;"&gt;Pak Joko memiliki \(\frac{7}{8}\) dus bakpia. Jika terjual \(\frac{3}{8}\) dus, berapa sisa stok?&lt;/p&gt;
                        
                        &lt;div style="display:flex;justify-content:center;gap:1.5rem;margin-top:1rem;flex-wrap:wrap;"&gt;
                            &lt;!-- Stok Awal --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:100px;height:100px;background:conic-gradient(#FF7D00 0% 87.5%, #f8fafc 87.5% 100%);border-radius:50%;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#FF7D00;"&gt;\(\frac{7}{8}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Stok Awal&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Minus Symbol --&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#EF4444;"&gt;-&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Terjual --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:100px;height:100px;background:conic-gradient(#FF7D00 0% 37.5%, #f8fafc 37.5% 100%);border-radius:50%;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#FF7D00;"&gt;\(\frac{3}{8}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Terjual&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Equal Symbol --&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#EF4444;"&gt;=&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Hasil --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:100px;height:100px;background:conic-gradient(#FF7D00 0% 50%, #f8fafc 50% 100%);border-radius:50%;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#FF7D00;"&gt;\(\frac{4}{8}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Sisa&lt;/p&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                        
                        &lt;div style="background:#FEE2E2;padding:1rem;border-radius:8px;margin-top:1rem;"&gt;
                            &lt;p style="color:#991B1B;margin:0;font-weight:500;"&gt;Aturan: Jika penyebut sama, kurangkan pembilang: \(\frac{7}{8} - \frac{3}{8} = \frac{4}{8} = \frac{1}{2}\) (disederhanakan)&lt;/p&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                    
                    &lt;!-- Penyebut Berbeda --&gt;
                    &lt;div style="background:#ECFDF5;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;"&gt;
                        &lt;h4 style="color:#065F46;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                            &lt;i class="fas fa-weight-scale" style="color:#10B981;"&gt;&lt;/i&gt; Kasus Takaran Bahan
                        &lt;/h4&gt;
                        &lt;p style="color:#4a5568;"&gt;Resep membutuhkan \(\frac{3}{4}\) kg tepung, tetapi Ima hanya punya \(\frac{1}{2}\) kg. Berapa kekurangannya?&lt;/p&gt;
                        
                        &lt;div style="display:flex;justify-content:center;gap:1rem;margin-top:1rem;flex-wrap:wrap;"&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:60px;background:linear-gradient(to right, #FF9F1C 0% 75%, #f8fafc 75% 100%);border-radius:6px;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:37.5%;transform:translate(-50%,-50%);font-weight:bold;color:#065F46;"&gt;\(\frac{3}{4}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Kebutuhan&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#10B981;"&gt;-&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:60px;background:linear-gradient(to right, #FF9F1C 0% 50%, #f8fafc 50% 100%);border-radius:6px;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:25%;transform:translate(-50%,-50%);font-weight:bold;color:#065F46;"&gt;\(\frac{1}{2}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Stok&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#10B981;"&gt;=&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:60px;background:linear-gradient(to right, #FF9F1C 0% 25%, #f8fafc 25% 100%);border-radius:6px;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:12.5%;transform:translate(-50%,-50%);font-weight:bold;color:#065F46;"&gt;\(\frac{1}{4}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Kekurangan&lt;/p&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                        
                        &lt;div style="background:#D1FAE5;padding:1rem;border-radius:8px;margin-top:1rem;"&gt;
                            &lt;p style="color:#065F46;margin:0;font-weight:500;"&gt;Langkah Penyelesaian:&lt;/p&gt;
                            &lt;ol style="color:#065F46;margin:0.5rem 0 0 1rem;padding-left:1rem;"&gt;
                                &lt;li&gt;Samakan penyebut: KPK 4 dan 2 adalah 4&lt;/li&gt;
                                &lt;li&gt;Ubah \(\frac{1}{2}\) menjadi \(\frac{2}{4}\)&lt;/li&gt;
                                &lt;li&gt;Kurangi: \(\frac{3}{4} - \frac{2}{4} = \frac{1}{4}\)&lt;/li&gt;
                            &lt;/ol&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- 3. Perkalian Pecahan --&gt;
                &lt;div style="margin:2rem 0;"&gt;
                    &lt;h3 style="color:#4a5568;display:flex;align-items:center;gap:12px;font-weight:600;"&gt;
                        &lt;i class="fas fa-times-circle" style="color:#7C3AED;font-size:1.2em;"&gt;&lt;/i&gt; Perkalian Pecahan
                    &lt;/h3&gt;
                    
                    &lt;!-- Contoh Kontekstual --&gt;
                    &lt;div style="background:#F5F3FF;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;"&gt;
                        &lt;h4 style="color:#5B21B6;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                            &lt;i class="fas fa-boxes-stacked" style="color:#7C3AED;"&gt;&lt;/i&gt; Kasus Pesanan Bakpia
                        &lt;/h4&gt;
                        &lt;p style="color:#4a5568;"&gt;Setiap dus berisi \(\frac{3}{4}\) kg bakpia. Jika Bu Rina memesan 2\(\frac{1}{2}\) dus, berapa total beratnya?&lt;/p&gt;
                        
                        &lt;div style="display:flex;justify-content:center;gap:1.5rem;margin-top:1rem;flex-wrap:wrap;"&gt;
                            &lt;!-- Per Dus --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:60px;background:linear-gradient(to right, #FF7D00 0% 75%, #f8fafc 75% 100%);border-radius:6px;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:37.5%;transform:translate(-50%,-50%);font-weight:bold;color:#5B21B6;"&gt;\(\frac{3}{4}\) kg&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Per Dus&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Times Symbol --&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#7C3AED;"&gt;×&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Jumlah --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:60px;background:linear-gradient(to right, #FF7D00 0% 100%, #f8fafc 100% 100%);border-radius:6px;margin:0 auto;position:relative;border:1px dashed #7C3AED;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#5B21B6;"&gt;2\(\frac{1}{2}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Jumlah Dus&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Equal Symbol --&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#7C3AED;"&gt;=&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Hasil --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:60px;background:linear-gradient(to right, #FF7D00 0% 187.5%, #f8fafc 187.5% 100%);border-radius:6px;margin:0 auto;position:relative;overflow:hidden;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#5B21B6;"&gt;1\(\frac{7}{8}\) kg&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Total&lt;/p&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                        
                        &lt;div style="background:#EDE9FE;padding:1rem;border-radius:8px;margin-top:1rem;"&gt;
                            &lt;p style="color:#5B21B6;margin:0;font-weight:500;"&gt;Langkah Penyelesaian:&lt;/p&gt;
                            &lt;ol style="color:#5B21B6;margin:0.5rem 0 0 1rem;padding-left:1rem;"&gt;
                                &lt;li&gt;Ubah bilangan campuran: 2\(\frac{1}{2}\) = \(\frac{5}{2}\)&lt;/li&gt;
                                &lt;li&gt;Kalikan pembilang dengan pembilang: 3×5 = 15&lt;/li&gt;
                                &lt;li&gt;Kalikan penyebut dengan penyebut: 4×2 = 8&lt;/li&gt;
                                &lt;li&gt;Hasil: \(\frac{15}{8}\) = 1\(\frac{7}{8}\)&lt;/li&gt;
                            &lt;/ol&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- 4. Pembagian Pecahan --&gt;
                &lt;div style="margin:2rem 0;"&gt;
                    &lt;h3 style="color:#4a5568;display:flex;align-items:center;gap:12px;font-weight:600;"&gt;
                        &lt;i class="fas fa-divide" style="color:#EC4899;font-size:1.2em;"&gt;&lt;/i&gt; Pembagian Pecahan
                    &lt;/h3&gt;
                    
                    &lt;!-- Contoh Kontekstual --&gt;
                    &lt;div style="background:#FDF2F8;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;"&gt;
                        &lt;h4 style="color:#9D174D;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                            &lt;i class="fas fa-people-group" style="color:#EC4899;"&gt;&lt;/i&gt; Kasus Pembagian Bakpia
                        &lt;/h4&gt;
                        &lt;p style="color:#4a5568;"&gt;Pak Joko memiliki 3\(\frac{1}{2}\) dus bakpia untuk dibagikan ke 7 pedagang sama rata. Berapa masing-masing bagian?&lt;/p&gt;
                        
                        &lt;div style="display:flex;justify-content:center;gap:1.5rem;margin-top:1rem;flex-wrap:wrap;"&gt;
                            &lt;!-- Total --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:60px;background:linear-gradient(to right, #FF7D00 0% 100%, #f8fafc 100% 100%);border-radius:6px;margin:0 auto;position:relative;border:1px dashed #EC4899;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#9D174D;"&gt;3\(\frac{1}{2}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Total Bakpia&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Divide Symbol --&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#EC4899;"&gt;÷&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Pedagang --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:60px;height:60px;background:#FBCFE8;border-radius:50%;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#9D174D;"&gt;7&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Pedagang&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- Equal Symbol --&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#EC4899;"&gt;=&lt;/div&gt;
                            &lt;/div&gt;
                            
                       
                            &lt;p style="color:#9D174D;margin:0;font-weight:500;"&gt;Langkah Penyelesaian:&lt;/p&gt;
                            &lt;ol style="color:#9D174D;margin:0.5rem 0 0 1rem;padding-left:1rem;"&gt;
                                &lt;li&gt;Ubah bilangan campuran: 3\(\frac{1}{2}\) = \(\frac{7}{2}\)&lt;/li&gt;
                                &lt;li&gt;Ubah pembagian menjadi perkalian dengan kebalikan: \(\frac{7}{2} ÷ 7 = \frac{7}{2} × \frac{1}{7}\)&lt;/li&gt;
                                &lt;li&gt;Kalikan: \(\frac{7×1}{2×7} = \frac{7}{14} = \frac{1}{2}\)&lt;/li&gt;
                          
        answerDiv.style.display = "block";
    }
}

function showPreviousPhase() {
    // Navigasi ke fase sebelumnya (Perbandingan)
    document.getElementById('operasi-pecahan').style.display = 'none';
    document.getElementById('perbandingan-pecahan').style.display = 'block';
    window.scrollTo(0, 0);
}

function showNextPhase() {
    // Navigasi ke fase berikutnya (Aplikasi Pecahan)
    document.getElementById('operasi-pecahan').style.display = 'none';
    document.getElementById('aplikasi-pecahan').style.display = 'block';
    window.scrollTo(0, 0);
}
&lt;/script&gt;</div></div></div></div></div><div class="flex justify-end"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex items-center p-1 select-none duration-[1.5s] focus-within:transition-none hover:transition-none duration-300 group-hover/turn-messages:delay-300 pointer-events-none opacity-0 motion-safe:transition-opacity group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:opacity-100 group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:opacity-100 has-data-[state=open]:pointer-events-auto has-data-[state=open]:opacity-100" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy" aria-selected="false" data-testid="copy-turn-action-button" data-state="closed"><span class="touch:w-[38px] flex h-[30px] w-[30px] items-center justify-center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-md-heavy"><path fill-rule="evenodd" clip-rule="evenodd" d="M7 5C7 3.34315 8.34315 2 10 2H19C20.6569 2 22 3.34315 22 5V14C22 15.6569 20.6569 17 19 17H17V19C17 20.6569 15.6569 22 14 22H5C3.34315 22 2 20.6569 2 19V10C2 8.34315 3.34315 7 5 7H7V5ZM9 7H14C15.6569 7 17 8.34315 17 10V15H19C19.5523 15 20 14.5523 20 14V5C20 4.44772 19.5523 4 19 4H10C9.44772 4 9 4.44772 9 5V7ZM5 9C4.44772 9 4 9.44772 4 10V19C4 19.5523 4.44772 20 5 20H14C14.5523 20 15 19.5523 15 19V10C15 9.44772 14.5523 9 14 9H5Z" fill="currentColor"></path></svg></span></button><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Edit message" aria-selected="false" data-state="closed"><span class="touch:w-[38px] flex h-[30px] w-[30px] items-center justify-center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-md-heavy"><path fill-rule="evenodd" clip-rule="evenodd" d="M13.2929 4.29291C15.0641 2.52167 17.9359 2.52167 19.7071 4.2929C21.4784 6.06414 21.4784 8.93588 19.7071 10.7071L18.7073 11.7069L11.6135 18.8007C10.8766 19.5376 9.92793 20.0258 8.89999 20.1971L4.16441 20.9864C3.84585 21.0395 3.52127 20.9355 3.29291 20.7071C3.06454 20.4788 2.96053 20.1542 3.01362 19.8356L3.80288 15.1C3.9742 14.0721 4.46243 13.1234 5.19932 12.3865L13.2929 4.29291ZM13 7.41422L6.61353 13.8007C6.1714 14.2428 5.87846 14.8121 5.77567 15.4288L5.21656 18.7835L8.57119 18.2244C9.18795 18.1216 9.75719 17.8286 10.1993 17.3865L16.5858 11L13 7.41422ZM18 9.5858L14.4142 6.00001L14.7071 5.70712C15.6973 4.71693 17.3027 4.71693 18.2929 5.70712C19.2831 6.69731 19.2831 8.30272 18.2929 9.29291L18 9.5858Z" fill="currentColor"></path></svg></span></button></div></div></div></div></div></div></article><article class="text-token-text-primary w-full" dir="auto" data-testid="conversation-turn-20" data-scroll-anchor="false"><h6 class="sr-only">ChatGPT said:</h6><div class="text-base my-auto mx-auto py-5 [--thread-content-margin:--spacing(4)] @[37rem]:[--thread-content-margin:--spacing(6)] @[72rem]:[--thread-content-margin:--spacing(16)] px-(--thread-content-margin)"><div class="[--thread-content-max-width:32rem] @[34rem]:[--thread-content-max-width:40rem] @[64rem]:[--thread-content-max-width:48rem] mx-auto flex max-w-(--thread-content-max-width) flex-1 text-base gap-4 md:gap-5 lg:gap-6 group/turn-messages focus-visible:outline-hidden" tabindex="-1"><div class="group/conversation-turn relative flex w-full min-w-0 flex-col agent-turn"><div class="relative flex-col gap-1 md:gap-3"><div class="flex max-w-full flex-col grow"><div class="flex flex-col"><div class="pb-3"><span><div class="relative w-full text-start"><div class="flex w-full items-center justify-between text-start"><button disabled="" class="flex w-full items-center gap-0.5"><span class="flex items-center gap-1 text-start align-middle text-token-text-secondary" style="opacity: 1;">Image created</span></button></div></div></span></div><div class="pb-2"><div class="group/imagegen-image relative w-full overflow-hidden max-w-[480px] rounded-2xl" id="image-ee31fe8a-30b6-44f5-84af-cd86f2cc807a" tabindex="0" style="aspect-ratio: 1 / 1;"><div class="relative z-0 cursor-pointer overflow-hidden max-w-[480px]" aria-label="Generated image" style="aspect-ratio: 1 / 1;"><div class="absolute start-0 end-0 top-0 z-2 w-full overflow-hidden transition-[mask] ease-linear" style="height: 100%;"><img alt="Generated image" class="absolute top-0 z-1 w-full" src="./g31_files/1ba63661-ae86-4176-aaa8-2892cbb43c07.png" style="aspect-ratio: 1 / 1;"></div><div class="relative z-1 w-full overflow-hidden" style="aspect-ratio: 1 / 1; filter: blur(0px);"><img alt="Generated image" src="./g31_files/1ba63661-ae86-4176-aaa8-2892cbb43c07.png" style="opacity: 1; will-change: opacity; aspect-ratio: 1 / 1;"></div><div class="absolute inset-0 z-0 scale-110 overflow-hidden blur-2xl" style="aspect-ratio: 1 / 1;"><img alt="Generated image" class="absolute top-0 w-full" src="./g31_files/1ba63661-ae86-4176-aaa8-2892cbb43c07.png"></div></div><div class="absolute z-2 opacity-0 group-hover/imagegen-image:opacity-100 group-focus/imagegen-image:opacity-100 focus-within:opacity-100 end-0 bottom-0 w-full"><div class="bg-linear-to-b from-transparent to-black/30 h-20 w-full"></div><div class="absolute inset-0 flex p-1 items-end justify-end"><div class="flex w-full items-center justify-between"><div class="flex"><span class="" data-state="closed"><button class="hover:bg-white/15 hover:backdrop-blur-md focus:bg-white/15 focus:backdrop-blur-md z-11 flex h-10 items-center justify-center gap-1 rounded-xl text-sm font-medium text-white w-10" aria-label="Like this image"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-sidebar fill-transparent" style="filter: drop-shadow(rgba(0, 0, 0, 0.15) 0px 2px 4px);"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.1318 2.50389C12.3321 2.15338 12.7235 1.95768 13.124 2.00775L13.5778 2.06447C16.0449 2.37286 17.636 4.