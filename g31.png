up/conversation-turn relative flex w-full min-w-0 flex-col"><div class="relative flex-col gap-1 md:gap-3"><div class="flex max-w-full flex-col grow"><div data-message-author-role="user" data-message-id="c8641f17-4681-4b37-a0bd-90f842848e35" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-5"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="relative max-w-[var(--user-chat-width,70%)] bg-token-message-surface rounded-3xl px-5 py-2.5"><div class="whitespace-pre-wrap">&lt;!-- Fase 3: Pengertian &amp; Jenis-Jenis Pecahan (Lengkap) --&gt;
&lt;div id="faktor" class="tab-content"&gt;
    &lt;section class="about-section"&gt;
        &lt;h2 class="section-title"&gt;Fase 3: Mengenal Pecahan dan Jenisnya&lt;/h2&gt;
        &lt;div class="about-content"&gt;
            &lt;div class="about-image"&gt;
                &lt;img src="https://i.ibb.co/0jq7YyL/fraction-types.png" 
                     alt="Jenis-Jenis Pecahan" 
                     style="border-radius:15px;box-shadow:0 10px 30px rgba(0,0,0,0.15);max-width:100%;height:auto;border:1px solid #eee;"&gt;
                &lt;div style="margin-top:1.5rem;text-align:center;"&gt;
                    &lt;button onclick="showFractionTypes()" style="background:linear-gradient(135deg, #2EC4B6, #4CC9F0);color:white;border:none;padding:0.7rem 1.5rem;border-radius:8px;cursor:pointer;font-weight:500;transition:all 0.3s ease;box-shadow:0 4px 6px rgba(0,0,0,0.1);"&gt;
                        &lt;i class="fas fa-shapes" style="margin-right:8px;"&gt;&lt;/i&gt; Jelajahi Jenis Pecahan
                    &lt;/button&gt;
                &lt;/div&gt;
            &lt;/div&gt;
            &lt;div class="about-text"&gt;
                &lt;h2 style="color:#4a5568;font-weight:600;border-bottom:2px solid #e2e8f0;padding-bottom:0.5rem;"&gt;🔢 Apa Itu Pecahan?&lt;/h2&gt;
                &lt;div class="context-example" style="background:#f8fafc;padding:1.5rem;border-radius:12px;border-left:4px solid #2EC4B6;margin-bottom:2rem;"&gt;
                    &lt;p style="font-style:italic;color:#4a5568;margin:0;font-size:1.05rem;"&gt;"Pecahan adalah cara matematis untuk membagi 'keseluruhan' (seperti bakpia, gudeg, atau kain batik) menjadi bagian-bagian yang sama!"&lt;/p&gt;
                &lt;/div&gt;

                &lt;!-- Definisi Pecahan --&gt;
                &lt;div style="margin:2rem 0;"&gt;
                    &lt;h3 style="color:#4a5568;display:flex;align-items:center;gap:12px;font-weight:600;"&gt;
                        &lt;i class="fas fa-question-circle" style="color:#E71D36;font-size:1.2em;"&gt;&lt;/i&gt; Definisi Matematis
                    &lt;/h3&gt;
                    &lt;p style="color:#4a5568;"&gt;Bentuk umum: &lt;span style="color:#E71D36;font-weight:bold;"&gt;\(\frac{a}{b}\)&lt;/span&gt;, di mana:&lt;/p&gt;
                    &lt;ul style="color:#4a5568;margin-left:1.5rem;"&gt;
                        &lt;li&gt;&lt;strong&gt;\(a\) (pembilang)&lt;/strong&gt;: Bagian yang diambil (contoh: 1 potong bakpia dari 4).&lt;/li&gt;
                        &lt;li&gt;&lt;strong&gt;\(b\) (penyebut)&lt;/strong&gt;: Total bagian keseluruhan (contoh: 1 dus bakpia dibagi 4).&lt;/li&gt;
                    &lt;/ul&gt;
                    
                    &lt;div style="background:#f8fafc;padding:1.5rem;border-radius:12px;margin-top:1rem;text-align:center;"&gt;
                        &lt;div style="display:flex;justify-content:center;gap:2rem;align-items:center;flex-wrap:wrap;"&gt;
                            &lt;!-- Bakpia Example --&gt;
                            &lt;div style="flex:1;min-width:150px;"&gt;
                                &lt;div style="width:100px;height:100px;background:conic-gradient(#FF7D00 0% 25%, #f8fafc 25% 100%);border-radius:50%;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#FF7D00;"&gt;\(\frac{1}{4}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;\(\frac{1}{4}\) dus bakpia untuk Pak Joko&lt;/p&gt;
                            &lt;/div&gt;
                            &lt;!-- Gudeg Example --&gt;
                            &lt;div style="flex:1;min-width:150px;"&gt;
                                &lt;div style="width:100px;height:50px;background:linear-gradient(to right, #FF9F1C 0% 75%, #f8fafc 75% 100%);border-radius:8px;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:37.5%;transform:translate(-50%,-50%);font-weight:bold;color:#FF7D00;"&gt;\(\frac{3}{4}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;\(\frac{3}{4}\) kg gula untuk gudeg&lt;/p&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- Jenis-Jenis Pecahan --&gt;
                &lt;div style="margin:2rem 0;"&gt;
                    &lt;h3 style="color:#4a5568;display:flex;align-items:center;gap:12px;font-weight:600;"&gt;
                        &lt;i class="fas fa-layer-group" style="color:#FF7D00;font-size:1.2em;"&gt;&lt;/i&gt; Jenis-Jenis Pecahan
                    &lt;/h3&gt;
                    
                    &lt;!-- 1. Pecahan Biasa --&gt;
                    &lt;div style="background:#fff7ed;padding:1rem;border-radius:8px;margin-bottom:1rem;"&gt;
                        &lt;h4 style="color:#DD6B20;margin:0 0 0.5rem 0;"&gt;1. Pecahan Biasa&lt;/h4&gt;
                        &lt;p style="color:#4a5568;margin:0;"&gt;Bentuk \(\frac{a}{b}\). Contoh dari kasus batik:&lt;/p&gt;
                        &lt;div style="display:flex;align-items:center;gap:1rem;margin-top:0.5rem;"&gt;
                            &lt;div style="width:60px;height:30px;background:linear-gradient(to right, #E71D36 0% 33.33%, #f8fafc 33.33% 100%);border-radius:4px;border:1px solid #E71D36;"&gt;&lt;/div&gt;
                            &lt;span style="color:#4a5568;"&gt;Motif Parang: &lt;span style="font-weight:bold;color:#E71D36;"&gt;\(\frac{1}{3}\)&lt;/span&gt; meter&lt;/span&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                    
                    &lt;!-- 2. Pecahan Campuran --&gt;
                    &lt;div style="background:#f0f9ff;padding:1rem;border-radius:8px;margin-bottom:1rem;"&gt;
                        &lt;h4 style="color:#0C4A6E;margin:0 0 0.5rem 0;"&gt;2. Pecahan Campuran&lt;/h4&gt;
                        &lt;p style="color:#4a5568;margin:0;"&gt;Gabungan bilangan bulat + pecahan. Contoh modifikasi kasus gudeg:&lt;/p&gt;
                        &lt;div style="display:flex;align-items:center;gap:1rem;margin-top:0.5rem;"&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="width:40px;height:40px;background:#4CC9F0;border-radius:4px;display:flex;align-items:center;justify-content:center;color:white;font-weight:bold;"&gt;2&lt;/div&gt;
                                &lt;div style="width:40px;height:40px;background:linear-gradient(to bottom, #4CC9F0, #2EC4B6);border-radius:4px;display:flex;align-items:center;justify-content:center;color:white;font-weight:bold;"&gt;\(\frac{1}{4}\)&lt;/div&gt;
                            &lt;/div&gt;
                            &lt;span style="color:#4a5568;"&gt;Total gula untuk 3 resep: &lt;span style="font-weight:bold;color:#0C4A6E;"&gt;\(2\frac{1}{4}\) kg&lt;/span&gt;&lt;/span&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                    
                    &lt;!-- 3. Pecahan Senilai --&gt;
                    &lt;div style="background:#f5f3ff;padding:1rem;border-radius:8px;margin-bottom:1rem;"&gt;
                        &lt;h4 style="color:#5B21B6;margin:0 0 0.5rem 0;"&gt;3. Pecahan Senilai&lt;/h4&gt;
                        &lt;p style="color:#4a5568;margin:0;"&gt;Nilai sama, bentuk berbeda. Contoh dari kasus bakpia:&lt;/p&gt;
                        &lt;div style="display:flex;align-items:center;gap:1rem;margin-top:0.5rem;flex-wrap:wrap;"&gt;
                            &lt;div style="width:40px;height:40px;background:conic-gradient(#FF7D00 0% 50%, #f8fafc 50% 100%);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;color:#FF7D00;"&gt;\(\frac{1}{2}\)&lt;/div&gt;
                            &lt;span style="color:#4a5568;"&gt;=&lt;/span&gt;
                            &lt;div style="width:40px;height:40px;background:conic-gradient(#FF7D00 0% 25%, #f8fafc 25% 100%);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;color:#FF7D00;"&gt;\(\frac{1}{4}\)&lt;/div&gt;
                            &lt;span style="color:#4a5568;"&gt;+&lt;/span&gt;
                            &lt;div style="width:40px;height:40px;background:conic-gradient(#FF7D00 0% 25%, #f8fafc 25% 100%);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;color:#FF7D00;"&gt;\(\frac{1}{4}\)&lt;/div&gt;
                            &lt;span style="color:#4a5568;"&gt;→ &lt;span style="font-weight:bold;color:#5B21B6;"&gt;\(\frac{1}{2} = \frac{1}{4} + \frac{1}{4}\)&lt;/span&gt;&lt;/span&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                    
                    &lt;!-- 4. Pecahan Desimal --&gt;
                    &lt;div style="background:#ecfdf5;padding:1rem;border-radius:8px;margin-bottom:1rem;"&gt;
                        &lt;h4 style="color:#065F46;margin:0 0 0.5rem 0;"&gt;4. Pecahan Desimal&lt;/h4&gt;
                        &lt;p style="color:#4a5568;margin:0;"&gt;Bentuk persepuluhan. Contoh kasus gudeg:&lt;/p&gt;
                        &lt;div style="display:flex;align-items:center;gap:1rem;margin-top:0.5rem;"&gt;
                            &lt;div style="width:100px;height:40px;background:linear-gradient(to right, #10B981 0% 50%, #ECFDF5 50% 100%);border-radius:6px;display:flex;align-items:center;justify-content:center;color:white;font-weight:bold;"&gt;0.5&lt;/div&gt;
                            &lt;span style="color:#4a5568;"&gt;Setara dengan &lt;span style="font-weight:bold;color:#065F46;"&gt;\(\frac{1}{2}\) sdt ketumbar&lt;/span&gt;&lt;/span&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- Aktivitas Interaktif --&gt;
                &lt;div style="background:#f8fafc;padding:1.5rem;border-radius:12px;margin-top:2rem;border:1px dashed #FF7D00;"&gt;
                    &lt;h3 style="color:#FF7D00;margin-top:0;font-weight:600;display:flex;align-items:center;gap:10px;"&gt;
                        &lt;i class="fas fa-lightbulb" style="font-size:1.2em;"&gt;&lt;/i&gt; Coba Praktikkan!
                    &lt;/h3&gt;
                   &lt;div style="display:flex;flex-wrap:wrap;gap:1rem;margin-top:1rem;"&gt;
    &lt;div style="flex:1;min-width:200px;background:white;padding:1rem;border-radius:8px;box-shadow:0 4px 6px rgba(0,0,0,0.05);"&gt;
        &lt;h4 style="color:#4a5568;margin:0 0 0.5rem 0;"&gt;💡 Bakpia Matematis&lt;/h4&gt;
        &lt;p style="color:#4a5568;margin:0;font-size:0.9rem;"&gt;"Jika 1 dus bakpia dibagi 8 orang, berapa bagian masing-masing?"&lt;/p&gt;
        &lt;div style="margin-top:0.5rem;"&gt;
            &lt;input type="text" id="bakpiaAnswer" placeholder="Jawaban..." style="width:100%;padding:0.5rem;border:1px solid #e2e8f0;border-radius:4px;"&gt;
        &lt;/div&gt;
        &lt;div style="margin-top:0.5rem;text-align:right;"&gt;
            &lt;button onclick="checkBakpiaAnswer()" style="background:#4CC9F0;color:white;border:none;padding:0.5rem 1rem;border-radius:4px;cursor:pointer;font-size:0.9rem;"&gt;
                Periksa Jawaban
            &lt;/button&gt;
        &lt;/div&gt;
        &lt;div id="bakpiaFeedback" style="margin-top:0.5rem;display:none;"&gt;&lt;/div&gt;
    &lt;/div&gt;
    &lt;!-- Kotak aktivitas lainnya... --&gt;
&lt;/div&gt;

&lt;script&gt;
function checkBakpiaAnswer() {
    const userAnswer = document.getElementById('bakpiaAnswer').value.trim().toLowerCase();
    const feedbackDiv = document.getElementById('bakpiaFeedback');
    
    // Jawaban yang diterima (dalam berbagai format)
    const correctAnswers = ['1/8', '⅛', '0.125', 'seperdelapan', '1 per 8'];
    
    // Memeriksa apakah jawaban user sesuai dengan salah satu format yang benar
    const isCorrect = correctAnswers.some(answer =&gt; 
        userAnswer === answer.toLowerCase()
    );
    
    if (isCorrect) {
    feedbackDiv.innerHTML = '&lt;p style="color:#10B981;margin:0;"&gt;✅ Jawaban benar! Setiap orang mendapat &lt;span style="font-weight:bold;"&gt;⅛&lt;/span&gt; dus bakpia.&lt;/p&gt;';
} else {
        feedbackDiv.innerHTML = '&lt;p style="color:#E71D36;margin:0;"&gt;❌ Jawaban belum tepat. Coba ingat lagi: 1 dus dibagi 8 orang = &lt;span style="font-weight:bold;"&gt;\(\frac{1}{8}\)&lt;/span&gt; untuk masing-masing.&lt;/p&gt;';
    }
    
    feedbackDiv.style.display = 'block';
    
    // Tambahkan animasi feedback
    feedbackDiv.style.animation = 'fadeIn 0.5s';
}

// Tambahkan style untuk animasi
const style = document.createElement('style');
style.textContent = <code>
</code>    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
<code>;
</code>document.head.appendChild(style);
&lt;/script&gt;
                        &lt;div style="flex:1;min-width:200px;background:white;padding:1rem;border-radius:8px;box-shadow:0 4px 6px rgba(0,0,0,0.05);"&gt;
    &lt;h4 style="color:#4a5568;margin:0 0 0.5rem 0;"&gt;🎨 Batik Pecahan&lt;/h4&gt;
    &lt;p style="color:#4a5568;margin:0;font-size:0.9rem;"&gt;"Jika motif Kawung diperbesar jadi ⅓ meter, berapa total kain?"&lt;/p&gt;
    &lt;div style="margin-top:0.5rem;"&gt;
        &lt;button onclick="showBatikSolution()" style="background:#4CC9F0;color:white;border:none;padding:0.5rem 1rem;border-radius:4px;cursor:pointer;font-size:0.9rem;"&gt;Lihat Solusi&lt;/button&gt;
    &lt;/div&gt;
    &lt;div id="batikSolution" style="margin-top:0.8rem;display:none;padding:0.8rem;background:#f8fafc;border-radius:6px;border-left:3px solid #4CC9F0;animation:fadeIn 0.3s;"&gt;
        &lt;p style="margin:0;color:#4a5568;"&gt;
            &lt;span style="font-weight:bold;color:#0C4A6E;"&gt;Solusi:&lt;/span&gt;&lt;br&gt;
            Motif Parang (⅓) + Motif Kawung (⅓) + Motif Ceplok (⅓) = &lt;span style="font-weight:bold;"&gt;1 meter&lt;/span&gt;
        &lt;/p&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;script&gt;
function showBatikSolution() {
    const solutionDiv = document.getElementById('batikSolution');
    if (solutionDiv.style.display === 'none') {
        solutionDiv.style.display = 'block';
    } else {
        solutionDiv.style.display = 'none';
    }
}
&lt;/script&gt;

&lt;style&gt;
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
}
&lt;/style&gt;
                    &lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- Navigasi Fase --&gt;
                &lt;div style="display:flex;justify-content:space-between;margin-top:3rem;"&gt;
                    
                   
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/section&gt;
&lt;/div&gt;

&lt;script&gt;
function showFractionTypes() {
    // Interactive modal showing fraction conversions
    alert("Simulasi interaktif: Drag bakpia/kain untuk melihat konversi pecahan!");
}

function checkAnswer(type) {
    const answers = {
        'bakpia': '\(\frac{1}{8}\) dus',
        'batik': '\(\frac{1}{3}\) (Parang) + \(\frac{1}{3}\) (Kawung) + \(\frac{1}{3}\) (Ceplok) = 1 meter'
    };
    alert(<code>Jawaban: ${answers[type]}</code>);
}

function showPreviousPhase() {
    document.getElementById('sifat').scrollIntoView({behavior: 'smooth'});
}

function showNextPhase() {
    // You can add navigation to the next phase (Operasi Pecahan)
    alert("Menuju ke fase operasi pecahan...");
}
&lt;/script&gt;

