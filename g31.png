flex w-full min-w-0 flex-col"><div class="relative flex-col gap-1 md:gap-3"><div class="flex max-w-full flex-col grow"><div data-message-author-role="user" data-message-id="1bc41ee3-2c26-4c4b-a1e6-7c6e24eb46f9" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal [.text-message+&amp;]:mt-5"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="relative max-w-[var(--user-chat-width,70%)] bg-token-message-surface rounded-3xl px-5 py-2.5"><div class="whitespace-pre-wrap">Tolong buatkan gambar beranimasi untuk mewakilkan cerita ini
&lt;!-- Fase 4: Membandingkan Pecahan (RME Kontekstual) --&gt;
&lt;div id="perbandingan" class="tab-content"&gt;
    &lt;section class="about-section"&gt;
        &lt;h2 class="section-title"&gt;Fase 4: Membandingkan Pecahan dalam Konteks Nyata&lt;/h2&gt;
        &lt;div class="about-content"&gt;
            &lt;div class="about-image"&gt;
                &lt;img src="https://i.ibb.co/4W2z3YJ/fraction-comparison.png" 
                     alt="Perbandingan Pecahan" 
                     style="border-radius:15px;box-shadow:0 10px 30px rgba(0,0,0,0.15);max-width:100%;height:auto;border:1px solid #eee;"&gt;
                &lt;div style="margin-top:1.5rem;text-align:center;"&gt;
                    &lt;button onclick="showComparisonTool()" style="background:linear-gradient(135deg, #FF9F1C, #FFBF69);color:white;border:none;padding:0.7rem 1.5rem;border-radius:8px;cursor:pointer;font-weight:500;transition:all 0.3s ease;box-shadow:0 4px 6px rgba(0,0,0,0.1);"&gt;
                        &lt;i class="fas fa-balance-scale" style="margin-right:8px;"&gt;&lt;/i&gt; Alat Perbandingan
                    &lt;/button&gt;
                &lt;/div&gt;
            &lt;/div&gt;
            &lt;div class="about-text"&gt;
                &lt;h2 style="color:#4a5568;font-weight:600;border-bottom:2px solid #e2e8f0;padding-bottom:0.5rem;"&gt;⚖️ Membandingkan Pecahan&lt;/h2&gt;
                &lt;div class="context-example" style="background:#f8fafc;padding:1.5rem;border-radius:12px;border-left:4px solid #FF9F1C;margin-bottom:2rem;"&gt;
                    &lt;p style="font-style:italic;color:#4a5568;margin:0;font-size:1.05rem;"&gt;"Bagaimana menentukan bagian bakpia yang lebih besar? Atau takaran gula yang lebih kecil? Mari bandingkan!"&lt;/p&gt;
                &lt;/div&gt;

                &lt;!-- 1. Konsep Dasar Perbandingan --&gt;
                &lt;div style="margin:2rem 0;"&gt;
                    &lt;h3 style="color:#4a5568;display:flex;align-items:center;gap:12px;font-weight:600;"&gt;
                        &lt;i class="fas fa-arrows-alt-h" style="color:#2EC4B6;font-size:1.2em;"&gt;&lt;/i&gt; Dasar Membandingkan
                    &lt;/h3&gt;
                    
                    &lt;!-- Bakpia Comparison --&gt;
                    &lt;div style="background:#f0fdf4;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;"&gt;
                        &lt;h4 style="color:#166534;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                            &lt;i class="fas fa-cookie" style="color:#FF7D00;"&gt;&lt;/i&gt; Kasus Bakpia
                        &lt;/h4&gt;
                        &lt;p style="color:#4a5568;"&gt;Pak Joko membagi 1 dus bakpia menjadi 8 bagian sama rata (\(\frac{1}{8}\)), sedangkan Bu Rina membagi dus serupa menjadi 4 bagian (\(\frac{1}{4}\)). Mana yang lebih besar?&lt;/p&gt;
                        
                        &lt;div style="display:flex;justify-content:center;gap:1.5rem;margin-top:1rem;flex-wrap:wrap;"&gt;
                            &lt;!-- 1/8 --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:90px;height:90px;background:conic-gradient(#FF7D00 0% 12.5%, #f8fafc 12.5% 100%);border-radius:50%;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#FF7D00;"&gt;\(\frac{1}{8}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;1 potong dari 8&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- VS Symbol --&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#E71D36;"&gt;?&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- 1/4 --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:90px;height:90px;background:conic-gradient(#FF7D00 0% 25%, #f8fafc 25% 100%);border-radius:50%;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-weight:bold;color:#FF7D00;"&gt;\(\frac{1}{4}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;1 potong dari 4&lt;/p&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                        
                        &lt;div style="background:#dcfce7;padding:1rem;border-radius:8px;margin-top:1rem;display:none;" id="bakpiaSolution"&gt;
                            &lt;p style="color:#166534;margin:0;font-weight:500;"&gt;\(\frac{1}{4} &gt; \frac{1}{8}\) karena potongan lebih sedikit = bagian lebih besar!&lt;/p&gt;
                        &lt;/div&gt;
                        
                        &lt;button onclick="toggleSolution('bakpiaSolution')" style="background:#22C55E;color:white;border:none;padding:0.5rem 1rem;border-radius:6px;cursor:pointer;margin-top:1rem;display:flex;align-items:center;gap:6px;font-size:0.9rem;"&gt;
                            &lt;i class="fas fa-lightbulb"&gt;&lt;/i&gt; Tunjukkan Solusi
                        &lt;/button&gt;
                    &lt;/div&gt;
                    
                    &lt;!-- Gudeg Comparison --&gt;
                    &lt;div style="background:#fef2f2;padding:1.5rem;border-radius:12px;margin-bottom:1.5rem;"&gt;
                        &lt;h4 style="color:#991B1B;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                            &lt;i class="fas fa-utensils" style="color:#E71D36;"&gt;&lt;/i&gt; Kasus Gudeg
                        &lt;/h4&gt;
                        &lt;p style="color:#4a5568;"&gt;Resep gudeg membutuhkan \(\frac{3}{4}\) kg gula merah, tetapi Ima hanya punya \(\frac{2}{3}\) kg. Cukupkah?&lt;/p&gt;
                        
                        &lt;div style="display:flex;justify-content:center;gap:1.5rem;margin-top:1rem;flex-wrap:wrap;"&gt;
                            &lt;!-- 3/4 --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:40px;background:linear-gradient(to right, #FF9F1C 0% 75%, #f8fafc 75% 100%);border-radius:6px;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:37.5%;transform:translate(-50%,-50%);font-weight:bold;color:#991B1B;"&gt;\(\frac{3}{4}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Kebutuhan resep&lt;/p&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- VS Symbol --&gt;
                            &lt;div style="display:flex;align-items:center;"&gt;
                                &lt;div style="font-size:1.5rem;font-weight:bold;color:#E71D36;"&gt;?&lt;/div&gt;
                            &lt;/div&gt;
                            
                            &lt;!-- 2/3 --&gt;
                            &lt;div style="text-align:center;"&gt;
                                &lt;div style="width:120px;height:40px;background:linear-gradient(to right, #FF9F1C 0% 66.66%, #f8fafc 66.66% 100%);border-radius:6px;margin:0 auto;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:33.33%;transform:translate(-50%,-50%);font-weight:bold;color:#991B1B;"&gt;\(\frac{2}{3}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;p style="margin-top:0.5rem;color:#4a5568;"&gt;Stok Ima&lt;/p&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                        
                        &lt;div style="background:#fee2e2;padding:1rem;border-radius:8px;margin-top:1rem;display:none;" id="gudegSolution"&gt;
                            &lt;p style="color:#991B1B;margin:0;font-weight:500;"&gt;\(\frac{3}{4} = 0.75\) vs \(\frac{2}{3} ≈ 0.67\), jadi stok Ima &lt;strong&gt;kurang&lt;/strong&gt;!&lt;/p&gt;
                        &lt;/div&gt;
                        
                        &lt;button onclick="toggleSolution('gudegSolution')" style="background:#EF4444;color:white;border:none;padding:0.5rem 1rem;border-radius:6px;cursor:pointer;margin-top:1rem;display:flex;align-items:center;gap:6px;font-size:0.9rem;"&gt;
                            &lt;i class="fas fa-lightbulb"&gt;&lt;/i&gt; Tunjukkan Solusi
                        &lt;/button&gt;
                    &lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- 2. Strategi Membandingkan --&gt;
                &lt;div style="margin:2rem 0;"&gt;
                    &lt;h3 style="color:#4a5568;display:flex;align-items:center;gap:12px;font-weight:600;"&gt;
                        &lt;i class="fas fa-chess-board" style="color:#4CC9F0;font-size:1.2em;"&gt;&lt;/i&gt; 3 Cara Membandingkan
                    &lt;/h3&gt;
                    
                    &lt;div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));gap:1.5rem;margin-top:1.5rem;"&gt;
                        &lt;!-- Metode 1 --&gt;
                        &lt;div style="background:#eff6ff;padding:1.25rem;border-radius:10px;border-left:4px solid #3B82F6;"&gt;
                            &lt;h4 style="color:#1E40AF;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                                &lt;i class="fas fa-ruler-combined"&gt;&lt;/i&gt; 1. Penyebut Sama
                            &lt;/h4&gt;
                            &lt;p style="color:#4a5568;"&gt;Bandingkan pembilangnya saja. Contoh pada kain batik:&lt;/p&gt;
                            &lt;div style="display:flex;justify-content:center;gap:1rem;margin:1rem 0;"&gt;
                                &lt;div style="width:60px;height:30px;background:linear-gradient(to right, #5B21B6 0% 40%, #f8fafc 40% 100%);border-radius:4px;border:1px solid #5B21B6;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:20%;transform:translate(-50%,-50%);font-weight:bold;color:#5B21B6;font-size:0.8rem;"&gt;\(\frac{2}{5}\)&lt;/div&gt;
                                &lt;/div&gt;
                                &lt;span style="font-weight:bold;color:#1E40AF;"&gt;&amp;lt;&lt;/span&gt;
                                &lt;div style="width:60px;height:30px;background:linear-gradient(to right, #5B21B6 0% 60%, #f8fafc 60% 100%);border-radius:4px;border:1px solid #5B21B6;position:relative;"&gt;
                                    &lt;div style="position:absolute;top:50%;left:30%;transform:translate(-50%,-50%);font-weight:bold;color:#5B21B6;font-size:0.8rem;"&gt;\(\frac{3}{5}\)&lt;/div&gt;
                                &lt;/div&gt;
                            &lt;/div&gt;
                            &lt;p style="color:#4a5568;font-size:0.9rem;"&gt;Motif \(\frac{2}{5}\)m lebih pendek dari \(\frac{3}{5}\)m&lt;/p&gt;
                        &lt;/div&gt;
                        
                        &lt;!-- Metode 2 --&gt;
                        &lt;div style="background:#f5f3ff;padding:1.25rem;border-radius:10px;border-left:4px solid #7C3AED;"&gt;
                            &lt;h4 style="color:#5B21B6;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                                &lt;i class="fas fa-project-diagram"&gt;&lt;/i&gt; 2. Penyebut Beda
                            &lt;/h4&gt;
                            &lt;p style="color:#4a5568;"&gt;Samakan penyebut (KPK). Contoh pembagian bakpia:&lt;/p&gt;
                            &lt;div style="margin:1rem 0;"&gt;
                                &lt;p style="color:#5B21B6;margin:0.5rem 0;font-size:0.9rem;"&gt;\(\frac{1}{4}\) vs \(\frac{2}{8}\) → \(\frac{2}{8}\) = \(\frac{2}{8}\)&lt;/p&gt;
                                &lt;div style="display:flex;justify-content:center;gap:0.5rem;"&gt;
                                    &lt;div style="width:40px;height:40px;background:conic-gradient(#FF7D00 0% 25%, #f8fafc 25% 100%);border-radius:50%;"&gt;&lt;/div&gt;
                                    &lt;span style="align-self:center;color:#5B21B6;font-weight:bold;"&gt;=&lt;/span&gt;
                                    &lt;div style="width:40px;height:40px;background:conic-gradient(#FF7D00 0% 25%, #f8fafc 25% 100%);border-radius:50%;"&gt;&lt;/div&gt;
                                &lt;/div&gt;
                            &lt;/div&gt;
                            &lt;p style="color:#4a5568;font-size:0.9rem;"&gt;\(\frac{1}{4}\) = \(\frac{2}{8}\) (bagian sama besar)&lt;/p&gt;
                        &lt;/div&gt;
                        
                        &lt;!-- Metode 3 --&gt;
                        &lt;div style="background:#ecfdf5;padding:1.25rem;border-radius:10px;border-left:4px solid #10B981;"&gt;
                            &lt;h4 style="color:#065F46;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                                &lt;i class="fas fa-calculator"&gt;&lt;/i&gt; 3. Desimal
                            &lt;/h4&gt;
                            &lt;p style="color:#4a5568;"&gt;Konversi ke bentuk desimal. Contoh takaran gula:&lt;/p&gt;
                            &lt;div style="background:#d1fae5;padding:0.75rem;border-radius:8px;margin:1rem 0;text-align:center;"&gt;
                                &lt;p style="margin:0;color:#065F46;font-weight:500;"&gt;
                                    \(\frac{3}{4}\) = 0.75 &amp;nbsp;&amp;nbsp;&gt;&amp;nbsp;&amp;nbsp; \(\frac{2}{3}\) ≈ 0.67
                                &lt;/p&gt;
                            &lt;/div&gt;
                            &lt;p style="color:#4a5568;font-size:0.9rem;"&gt;Lebih mudah dibandingkan dalam bentuk desimal&lt;/p&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- Aktivitas Interaktif --&gt;
                &lt;div style="background:#f8fafc;padding:1.5rem;border-radius:12px;margin-top:2rem;border:1px dashed #4CC9F0;"&gt;
                    &lt;h3 style="color:#4CC9F0;margin-top:0;font-weight:600;display:flex;align-items:center;gap:10px;"&gt;
                        &lt;i class="fas fa-tasks" style="font-size:1.2em;"&gt;&lt;/i&gt; Latihan Kontekstual
                    &lt;/h3&gt;
                    
                    &lt;!-- Soal 1 --&gt;
                    &lt;div style="background:white;padding:1.25rem;border-radius:10px;margin-top:1.5rem;box-shadow:0 4px 6px rgba(0,0,0,0.05);"&gt;
                        &lt;h4 style="color:#4a5568;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                            &lt;i class="fas fa-cookie-bite" style="color:#FF7D00;"&gt;&lt;/i&gt; Soal Bakpia
                        &lt;/h4&gt;
                        &lt;p style="color:#4a5568;"&gt;Jika 1 dus bakpia dibagi 6 orang (\(\frac{1}{6}\)) vs dibagi 3 orang (\(\frac{1}{3}\)), mana yang lebih besar?&lt;/p&gt;
                        &lt;div style="display:flex;gap:1rem;margin-top:1rem;"&gt;
                            &lt;button onclick="checkComparisonAnswer(1, '1/3 lebih besar karena pembagi lebih sedikit')" style="background:#EFF6FF;color:#3B82F6;border:1px solid #BFDBFE;padding:0.5rem 1rem;border-radius:6px;cursor:pointer;flex:1;"&gt;\(\frac{1}{6}\)&lt;/button&gt;
                            &lt;button onclick="checkComparisonAnswer(1, '1/3 lebih besar karena pembagi lebih sedikit')" style="background:#EFF6FF;color:#3B82F6;border:1px solid #BFDBFE;padding:0.5rem 1rem;border-radius:6px;cursor:pointer;flex:1;"&gt;\(\frac{1}{3}\)&lt;/button&gt;
                            &lt;button onclick="checkComparisonAnswer(1, '1/3 lebih besar karena pembagi lebih sedikit')" style="background:#EFF6FF;color:#3B82F6;border:1px solid #BFDBFE;padding:0.5rem 1rem;border-radius:6px;cursor:pointer;flex:1;"&gt;Sama&lt;/button&gt;
                        &lt;/div&gt;
                        &lt;div id="answer1" style="margin-top:1rem;display:none;"&gt;&lt;/div&gt;
                    &lt;/div&gt;
                    
                    &lt;!-- Soal 2 --&gt;
                    &lt;div style="background:white;padding:1.25rem;border-radius:10px;margin-top:1.5rem;box-shadow:0 4px 6px rgba(0,0,0,0.05);"&gt;
                        &lt;h4 style="color:#4a5568;margin-top:0;display:flex;align-items:center;gap:8px;"&gt;
                            &lt;i class="fas fa-utensil-spoon" style="color:#E71D36;"&gt;&lt;/i&gt; Soal Gudeg
                        &lt;/h4&gt;
                        &lt;p style="color:#4a5568;"&gt;Manakah yang lebih kecil: \(\frac{5}{8}\) kg gula merah atau \(\frac{2}{3}\) kg?&lt;/p&gt;
                        &lt;div style="display:flex;gap:1rem;margin-top:1rem;"&gt;
                            &lt;button onclick="checkComparisonAnswer(2, '5/8 ≈ 0.625 vs 2/3 ≈ 0.667 → 5/8 lebih kecil')" style="background:#FEF2F2;color:#EF4444;border:1px solid #FECACA;padding:0.5rem 1rem;border-radius:6px;cursor:pointer;flex:1;"&gt;\(\frac{5}{8}\)&lt;/button&gt;
                            &lt;button onclick="checkComparisonAnswer(2, '5/8 ≈ 0.625 vs 2/3 ≈ 0.667 → 5/8 lebih kecil')" style="background:#FEF2F2;color:#EF4444;border:1px solid #FECACA;padding:0.5rem 1rem;border-radius:6px;cursor:pointer;flex:1;"&gt;\(\frac{2}{3}\)&lt;/button&gt;
                            &lt;button onclick="checkComparisonAnswer(2, '5/8 ≈ 0.625 vs 2/3 ≈ 0.667 → 5/8 lebih kecil')" style="background:#FEF2F2;color:#EF4444;border:1px solid #FECACA;padding:0.5rem 1rem;border-radius:6px;cursor:pointer;flex:1;"&gt;Sama&lt;/button&gt;
                        &lt;/div&gt;
                        &lt;div id="answer2" style="margin-top:1rem;display:none;"&gt;&lt;/div&gt;
                    &lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- Navigasi Fase --&gt;
                &lt;div style="display:flex;justify-content:space-between;margin-top:3rem;"&gt;
                  
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/section&gt;
&lt;/div&gt;

&lt;script&gt;
function showComparisonTool() {
    alert("Buka alat interaktif untuk membandingkan pecahan dengan drag-and-drop!");
}

function toggleSolution(id) {
    const element = document.getElementById(id);
    element.style.display = element.style.display === 'none' ? 'block' : 'none';
}

function checkComparisonAnswer(questionNum, correctExplanation) {
    const answerDiv = document.getElementById(<code>answer${questionNum}</code>);
    answerDiv.innerHTML = <code>
</code>        &lt;div style="background:#ECFDF5;padding:1rem;border-radius:8px;border-left:4px solid #10B981;"&gt;
            &lt;p style="color:#065F46;margin:0;font-weight:500;"&gt;${correctExplanation}&lt;/p&gt;
        &lt;/div&gt;
    <code>;
</code>    answerDiv.style.display = 'block';
}

function showPreviousPhase() {
    document.getElementById('faktor').scrollIntoView({behavior: 'smooth'});
}

function showNextPhase() {
    alert("Menuju ke fase operasi pecahan...");
}
&lt;/script&gt;</div></div></div></div></div><div class="flex justify-end"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex items-center p-1 select-none duration-[1.5s] focus-within:transition-none hover:transition-none duration-300 group-hover/turn-messages:delay-300 pointer-events-none opacity-0 motion-safe:transition-opacity group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:opacity-100 group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:opacity-100 has-data-[state=open]:pointer-events-auto has-data-[state=open]:opacity-100" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy" aria-selected="false" data-testid="copy-turn-action-button" data-state="closed"><span class="touch:w-[38px] flex h-[30px] w-[30px] items-center justify-center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-md-heavy"><path fill-rule="evenodd" clip-rule="evenodd" d="M7 5C7 3.34315 8.34315 2 10 2H19C20.6569 2 22 3.34315 22 5V14C22 15.6569 20.6569 17 19 17H17V19C17 20.6569 15.6569 22 14 22H5C3.34315 22 2 20.6569 2 19V10C2 8.34315 3.34315 7 5 7H7V5ZM9 7H14C15.6569 7 17 8.34315 17 10V15H19C19.5523 15 20 14.5523 20 14V5C20 4.44772 19.5523 4 19 4H10C9.44772 4 9 4.44772 9 5V7ZM5 9C4.44772 9 4 9.44772 4 10V19C4 19.5523 4.44772 20 5 20H14C14.5523 20 15 19.5523 15 19V10C15 9.44772 14.5523 9 14 9H5Z" fill="currentColor"></path></svg></span></button><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Edit message" aria-selected="false" data-state="closed"><span class="touch:w-[38px] flex h-[30px] w-[30px] items-center justify-center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-md-heavy"><path fill-rule="evenodd" clip-rule="evenodd" d="M13.2929 4.29291C15.0641 2.52167 17.9359 2.52167 19.7071 4.2929C21.4784 